    } catch {\r\n      error({ message: 'Page not found' });\r\n    }\r\n  },\r\n\r\n  data () {\r\n    return {\r\n      loading: false,\r\n    };\r\n  },\r\n\r\n  head () {\r\n    return {\r\n      title: 'Search',\r\n      meta: [\r\n        { hid: 'og:title', property: 'og:title', content: 'Search' },\r\n        { hid: 'og:url', property: 'og:url', content: `${process.env.FRONTEND_URL}${this.$route.path}` },\r\n      ],\r\n      bodyAttrs: {\r\n        class: 'page page-search',\r\n      },\r\n    };\r\n  },\r\n\r\n  computed: {\r\n    query () {\r\n      return this.$route.query.q ? this.$route.query.q : '';\r\n    },\r\n\r\n    title () {\r\n      return this.query ? `Results For: ${this.query}` : '';\r\n    },\r\n  },",[1014,1511],"\r\n\r\n  beforeRouteEnter (to, from, next) {\r\n    fromPage = from.path;\r\n    next();\r\n  },\r\n\r\n  async asyncData ({ query, error, redirect }) {\r\n    try {\r\n      if (query.q) {\r\n        const items = await search(query.q, 1);\r\n        return { items };\r\n      } else {\r\n        redirect('/');\r\n      }\r\n    } catch {\r\n      error({ message: 'Page not found' });\r\n    }\r\n  },\r\n\r\n  mounted () {\r\n    this.$store.commit('search/openSearch');\r\n    this.$store.commit('search/setFromPage', fromPage);\r\n  },",[1014,1596],"\r\n\r\n  beforeRouteUpdate (to, from, next) {\r\n    next();\r\n    this.getResults();\r\n  },\r\n\r\n  async asyncData ({ query, error, redirect }) {\r\n    try {\r\n      if (query.q) {\r\n        const items = await search(query.q, 1);\r\n        return { items };\r\n      } else {\r\n        redirect('/');\r\n      }\r\n    } catch {\r\n      error({ message: 'Page not found' });\r\n    }\r\n  },\r\n\r\n  mounted () {\r\n    this.$store.commit('search/openSearch');\r\n    this.$store.commit('search/setFromPage', fromPage);\r\n  },\r\n\r\n  beforeRouteEnter (to, from, next) {\r\n    fromPage = from.path;\r\n    next();\r\n  },",[1014,1813],"\r\n\r\n  beforeRouteLeave (to, from, ne